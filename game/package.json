{
  "name": "gravel-riot",
  "version": "1.0.0",
  "description": "Off-road volcano racing",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win dir --x64 && makensis -DSRC=../release/win-unpacked -DOUT=../release/GravelRiot-Setup.exe electron/installer.nsi"
  },
  "keywords": [],
  "author": "Jonathan Martin",
  "license": "ISC",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^8.3.5"
  },
  "productName": "Gravel Riot",
  "build": {
    "appId": "com.gravelriot.game",
    "productName": "Gravel Riot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": "dir",
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "electronVersion": "33.2.1"
  }
}